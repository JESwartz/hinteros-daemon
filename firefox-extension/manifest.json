{
  "manifest_version": 2,
  "name": "HinterOS on-screen keyboard",
  "version": "0.3.2",
  "description": "Tells the HinterOS session daemon when a text field has focus, so that A on the controller, or a click into the field, brings up the TV's on-screen keyboard.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hinteros-osk@hinteros",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ]
}

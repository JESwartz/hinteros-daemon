{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.hinteros.org/hinteros-daemon/schema/api-doc.schema.json",
  "title": "HinterOS API document",
  "description": "Meta-schema for the HinterOS socket API documents (session-api.json, system-api.json). Every payload schema inside a document is JSON Schema 2020-12; '#/$defs/...' references resolve against the document root.",
  "type": "object",
  "required": ["api", "version", "transport", "methods", "events", "errors", "$defs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "api": { "description": "Which API this document describes.", "enum": ["session", "system"] },
    "version": {
      "description": "API version, MAJOR.MINOR. Exchanged in the 'hello' handshake.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": { "type": "string" },
    "transport": {
      "type": "object",
      "required": ["protocol", "framing", "socket"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "const": "jsonrpc-2.0" },
        "framing": { "const": "ndjson" },
        "socket": { "type": "string", "description": "Default socket path; $VARS are expanded by the implementation." },
        "max_message_bytes": { "type": "integer", "minimum": 1024 }
      }
    },
    "methods": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/methodName" },
      "additionalProperties": { "$ref": "#/$defs/method" }
    },
    "events": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/eventName" },
      "additionalProperties": { "$ref": "#/$defs/event" }
    },
    "errors": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/error" }
    },
    "$defs": {
      "description": "Shared payload types, referenced as '#/$defs/<Name>'.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/payloadSchema" }
    }
  },
  "$defs": {
    "methodName": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "eventName": { "pattern": "^[a-z][a-z0-9_]*$" },
    "since": {
      "description": "The minor that added this item (MAJOR.MINOR). Absent: part of the major's first version, x.0.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "payloadSchema": {
      "description": "A JSON Schema 2020-12 schema.",
      "type": ["object", "boolean"]
    },
    "objectSchema": {
      "description": "Params and results are always JSON objects.",
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "const": "object" } }
    },
    "method": {
      "type": "object",
      "required": ["summary", "params", "result", "errors", "examples"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "since": { "$ref": "#/$defs/since" },
        "handshake": {
          "description": "True only for the handshake method, the one method callable before the handshake.",
          "type": "boolean"
        },
        "relay": {
          "description": "Session API only: the session daemon forwards this method to the system service.",
          "type": "boolean"
        },
        "params": { "$ref": "#/$defs/objectSchema" },
        "result": { "$ref": "#/$defs/objectSchema" },
        "errors": {
          "description": "Method-specific errors (names from the document's 'errors'). Generic errors apply to every method and are not listed.",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "params"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "params": { "type": "object" },
              "result": { "type": "object" },
              "error": {
                "type": "object",
                "required": ["code", "message"],
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "integer" },
                  "message": { "type": "string" },
                  "data": {}
                }
              }
            },
            "oneOf": [{ "required": ["result"] }, { "required": ["error"] }]
          }
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["summary", "params", "examples"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "since": { "$ref": "#/$defs/since" },
        "params": { "$ref": "#/$defs/objectSchema" },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "params"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "params": { "type": "object" }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "summary"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "integer" },
        "summary": { "type": "string" },
        "since": { "$ref": "#/$defs/since" },
        "closes_connection": {
          "description": "The server closes the connection after sending this error.",
          "type": "boolean"
        },
        "data_optional": {
          "description": "The error may be sent without data (data, when present, must match the data schema).",
          "type": "boolean"
        },
        "data": { "$ref": "#/$defs/payloadSchema" }
      }
    }
  }
}
